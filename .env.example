# Copiá este archivo como .env.local para desarrollo local
# En Vercel, configurá estas variables en Settings > Environment Variables

# Anthropic (para el mapeo de columnas con IA)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# SAP Marketing Cloud (credenciales de acceso a la API SMC)
SMC_USER=tu_usuario_smc
SMC_PASSWORD=tu_password_smc

# Supabase (base de datos: usuarios y historial)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
